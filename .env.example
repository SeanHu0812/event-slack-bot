SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
NOTION_TOKEN=ntn_your-notion-integration-secret
ANTHROPIC_API_KEY=sk-ant-your-key
# Budget source (optional; without any of these, budget warnings are skipped).
# Preferred: a service-account key JSON on one line (or its base64).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Fallback: "Publish to web" CSV URLs, one per city tab. Used only when the
# service account above is not set.
BUDGET_CSV_NYC=https://docs.google.com/spreadsheets/d/e/.../pub?gid=...&single=true&output=csv
BUDGET_CSV_SF=https://docs.google.com/spreadsheets/d/e/.../pub?gid=...&single=true&output=csv
# Weekly rundown: channel IDs to post to (comma-separated) and the published-CSV
# URL of a "rep name -> Slack ID" tab. Without these, the rundown can't post/tag.
RUNDOWN_CHANNELS=C_ny_vc_squad_id,C_qualifiers_id
REP_MAP_CSV=https://docs.google.com/spreadsheets/d/e/.../pub?gid=...&single=true&output=csv
# Google Calendar (OAuth as sean.hu@rho.co) for cloning rundown events + guest sync.
# Optional: without these, calendar sync is skipped. Mint the refresh token once with
# get_google_token.py. The rep-map tab also needs an email column for guests.
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REFRESH_TOKEN=...
# Self-learning for proposal assessments. A blank Notion page (shared with the
# integration) the bot appends feedback signals to and reads guidelines from.
# Without it, the bot acknowledges feedback but can't persist or learn.
ASSESSMENT_MEMORY_PAGE_ID=...
# Revenue aspect of assessments (optional; uncomment snowflake in requirements.txt).
SNOWFLAKE_ACCOUNT=...
SNOWFLAKE_USER=...
SNOWFLAKE_PASSWORD=...
SNOWFLAKE_WAREHOUSE=...
SNOWFLAKE_DATABASE=...
SNOWFLAKE_SCHEMA=...
SNOWFLAKE_ROLE=...
REVENUE_SQL=SELECT ... WHERE EVENT ILIKE '%' || %(term)s || '%' LIMIT 25
